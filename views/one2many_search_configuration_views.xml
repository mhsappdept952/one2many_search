<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="one2many_search_configuration_view_list" model="ir.ui.view">
        <field name="name">one2many.search.configuration.list</field>
        <field name="model">one2many.search.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="line_model_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="one2many_search_configuration_view_form" model="ir.ui.view">
        <field name="name">one2many.search.configuration.form</field>
        <field name="model">one2many.search.configuration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="field_id"
                                   domain="[('model_id', '=', model_id), ('ttype', '=', 'one2many')]"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="line_model_id"/>
                        </group>
                    </group>
                    <group col="1">
                        <div class="d-flex align-items-center gap-3">
                            <label for="searchable_field_ids" class="o_form_label mb-0 text-nowrap"/>
                            <field name="searchable_field_ids" widget="many2many_tags" class="flex-grow-1"
                                   domain="[('model_id', '=', line_model_id), ('store', '=', True)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <button name="action_suggest_searchable_fields" type="object"
                                    string="Use Visible List Columns"
                                    class="btn-primary text-nowrap"
                                    invisible="not line_model_id"/>
                        </div>
                    </group>
                    <div class="text-muted">
                        Select the direct fields on each line that should be searched. Users only see search results allowed by their existing access rights and record rules.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="one2many_search_configuration_action" model="ir.actions.act_window">
        <field name="name">One2many Search</field>
        <field name="res_model">one2many.search.configuration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="one2many_search_menu_root" name="One2many Search"
              parent="base.next_id_9" action="one2many_search_configuration_action"
              sequence="90" groups="base.group_system"/>
</odoo>
