<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="nexmosaic_one2many_search.LegacyX2ManySearch">
        <div class="o_o2m_search mb-2 position-relative" role="search">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-search"/></span>
                </div>
                <input type="search" class="form-control o_o2m_search_input"
                       t-att-placeholder="widget._o2mSearchState.placeholder"
                       t-att-value="widget._o2mSearchState.term"/>
                <div t-if="widget._o2mSearchState.term || widget._o2mSearchState.matchingDataPointIds !== null"
                     class="input-group-append">
                    <button class="btn btn-outline-secondary o_o2m_search_clear" type="button"
                            title="Clear search" aria-label="Clear search">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </div>
            <div t-if="widget._o2mSearchState.showSuggestions"
                 class="dropdown-menu show o_o2m_search_suggestions">
                <button t-foreach="widget._o2mSearchSuggestions()" t-as="searchField"
                        class="dropdown-item o_o2m_search_suggestion" type="button"
                        t-att-data-field="searchField.name || ''"
                        t-att-data-label="searchField.label">
                    Search <strong t-esc="searchField.label"/> for:
                    <em t-esc="widget._o2mSearchState.term"/>
                </button>
            </div>
            <div t-if="widget._o2mSearchState.matchingDataPointIds !== null"
                 class="o_o2m_search_feedback d-flex align-items-center mt-1">
                <span class="badge badge-secondary">
                    <t t-esc="widget._o2mSearchState.selectedFieldLabel"/>:
                    <t t-esc="widget._o2mSearchState.selectedTerm"/>
                    <button type="button" class="o_o2m_search_chip_clear o_o2m_search_clear"
                            aria-label="Clear search" title="Clear search">&#215;</button>
                </span>
                <span t-if="!widget._o2mSearchState.loading" class="text-muted small ml-2">
                    <t t-esc="widget._o2mSearchState.matchingDataPointIds.size"/> matching line<t t-if="widget._o2mSearchState.matchingDataPointIds.size !== 1">s</t>
                </span>
            </div>
            <div t-if="widget._o2mSearchState.matchingDataPointIds !== null &amp;&amp; !widget._o2mSearchState.loading &amp;&amp; widget._o2mSearchState.matchingDataPointIds.size === 0"
                 class="o_o2m_search_empty text-muted small mt-1">
                No lines match this search.
            </div>
            <span t-if="widget._o2mSearchState.loading" class="o_o2m_search_loading text-muted small">
                <i class="fa fa-spinner fa-spin mr-1"/>Searching...
            </span>
        </div>
    </t>
</templates>
